pkgname=plate
pkgver=0.1.0
pkgrel=1
pkgdesc='Design a microplate layout and export it for a plate reader or liquid handler'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/plate "$pkgdir/usr/bin/plate"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/plate.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/plate.svg"
  install -Dm644 "$startdir/plate.desktop" "$pkgdir/usr/share/applications/plate.desktop"
  install -Dm644 "$startdir/plate.xml" "$pkgdir/usr/share/mime/packages/plate.xml"
}
